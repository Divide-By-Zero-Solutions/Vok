#!/bin/sh
set -e

if [ "${SKIP_PERFORMANCE_REPORT:-0}" = "1" ]; then
  echo "Skipping performance report because SKIP_PERFORMANCE_REPORT=1."
  exit 0
fi

if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/Update-PerformanceReport.ps1
else
  powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Update-PerformanceReport.ps1
fi

git add -- README.md
